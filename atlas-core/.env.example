# Copy to `.env` and adjust. Keys are sorted for dotenv-linter.
# Inside Docker Compose the DB hostname is `postgres`; from the host use 127.0.0.1 and ATLAS_CORE_POSTGRES_PORT.
# Percent-encode reserved URI characters in the database userinfo (e.g. p@ss -> postgres:p%40ss).
# Compose requires ATLAS_CORE_DATABASE_URL and POSTGRES_PASSWORD (see README).
ATLAS_CORE_ALLOWED_ORIGINS=http://localhost:5173
ATLAS_CORE_DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@postgres:5432/atlas_core?sslmode=disable
ATLAS_CORE_HOST_PORT=8080
ATLAS_CORE_LOG_LEVEL=info
ATLAS_CORE_POSTGRES_PORT=5432
ATLAS_DATA_FUSION_STACK=
POSTGRES_DB=atlas_core
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_USER=postgres
