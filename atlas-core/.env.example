ATLAS_CORE_ALLOWED_ORIGINS=http://localhost:5173
# This URL is for services on the Compose network: host name `postgres` is the DB service. From your machine (e.g. psql to localhost:5432), use 127.0.0.1 (or localhost) and the host-mapped port instead of `postgres`.
ATLAS_CORE_DATABASE_URL=postgres://postgres:postgres@postgres:5432/atlas_core?sslmode=disable
ATLAS_CORE_LOG_LEVEL=info
ATLAS_CORE_PORT=8080
ATLAS_CORE_POSTGRES_PORT=5432
ATLAS_DATA_FUSION_STACK=
POSTGRES_DB=atlas_core
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
