ATLAS_CORE_ALLOWED_ORIGINS=http://localhost:5173
# Compose network URL (hostname `postgres` is the DB service). From the host use 127.0.0.1 and ATLAS_CORE_POSTGRES_PORT.
ATLAS_CORE_DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@postgres:5432/atlas_core?sslmode=disable
ATLAS_CORE_LOG_LEVEL=info
# Host port published to your machine (maps to container port 8080). The process inside the container always listens on 8080.
ATLAS_CORE_HOST_PORT=8080
ATLAS_CORE_POSTGRES_PORT=5432
ATLAS_DATA_FUSION_STACK=
POSTGRES_DB=atlas_core
# Required for docker compose — choose a strong value for local dev.
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_USER=postgres
