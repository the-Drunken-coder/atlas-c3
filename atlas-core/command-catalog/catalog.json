        }
      }
    },
    {
      "type": "hold_position",
      "display_name": "Hold Position",
      "description": "Command an asset to remain in place for a duration.",
      "parameters_schema": {
        "type": "object",
        "required": ["duration_s"],
        "additionalProperties": false,
        "properties": {
          "duration_s": { "type": "integer", "minimum": 1, "maximum": 3600 }
        }
      }
    }
